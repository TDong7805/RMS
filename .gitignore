# Thư viện, file build, log
node_modules
dist
backend/target/
# Ảnh người dùng tải lên khi chạy backend (com.rms.storage.LocalStorageService)
uploads/
# Bản sao lưu dữ liệu tạo khi chạy backend (com.rms.backup)
backups/
*.log

# Mật khẩu, khóa: KHÔNG commit (gồm backend/.env.properties chứa mật khẩu MySQL)
.env
.env.*
# ...nhưng vẫn commit các file mẫu để người khác sao chép
!.env.example
!.env.properties.example

# Cấu hình riêng của IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.iml

