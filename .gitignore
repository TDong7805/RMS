# Thư viện, file build, log
node_modules
dist
backend/target/
# Ảnh người dùng tải lên khi chạy backend (com.rms.storage.LocalStorageService)
uploads/
# Ảnh tải lên khi chạy chế độ test (CSDL rms_test)
uploads-test/
# Bản sao lưu dữ liệu tạo khi chạy backend (com.rms.backup)
backups/
# Bản sao lưu tạo khi chạy chế độ test (CSDL rms_test)
backups-test/
*.log

# Mật khẩu, khóa: KHÔNG commit (gồm backend/.env.properties chứa mật khẩu MySQL)
.env
.env.*
# ...nhưng vẫn commit các file mẫu để người khác sao chép
!.env.example
!.env.properties.example

# Cấu hình riêng của IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.iml


# Dữ liệu thô tải từ mạng để đo tham số dự báo (file lớn, giấy phép riêng) — không đưa lên git
/data-raw/

# Tài liệu thiết kế giao diện (quy tắc + ảnh tham khảo) — chỉ để trên máy, không đưa lên git
/docs/thiet-ke/
