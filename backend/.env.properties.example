# Sao chép file này thành backend/.env.properties (file thật đã được .gitignore bỏ qua)
# rồi điền thông tin MySQL của máy bạn. CSDL chưa có thì backend tự tạo (Flyway).
# Giá trị chỉ dùng ký tự không dấu (file .properties được đọc theo bảng mã ISO-8859-1).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rms_db
DB_USER=root
DB_PASSWORD=dien-mat-khau-mysql-cua-ban

# ---- Chỉ dùng khi chạy thật (xem TRIEN_KHAI.md). Khi phát triển để nguyên các dòng có dấu # ----
# Chế độ chạy thật KHÔNG bật ở file này: chạy  java -jar rms.jar --spring.profiles.active=prod
# PORT=8080
# DB_SSL_MODE=REQUIRED            # khi MySQL nằm ở máy khác
# COOKIE_SECURE=true              # chỉ đặt false khi chạy thử trong mạng nội bộ không có HTTPS
# Tài khoản quản lý đầu tiên — chỉ dùng ở lần chạy đầu, đăng nhập xong phải đổi mật khẩu, rồi xóa 3 dòng này:
# RMS_BOOTSTRAP_USERNAME=quanly
# RMS_BOOTSTRAP_PASSWORD=mat-khau-tam-8-ky-tu-co-so
# RMS_BOOTSTRAP_EMAIL=quanly@ten-nha-hang.vn
